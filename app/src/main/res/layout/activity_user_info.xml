<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?attr/backgroundColor"
    android:orientation="vertical"
    tools:context=".activities.UserInfoActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.BBTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/Theme.BBTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llname"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/round_edit_text_background"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    app:tint="?attr/inputIconColor"
                    app:srcCompat="@drawable/ic_person" />

                <TextView
                    android:id="@+id/fullName"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/round_edit_text_background"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Muhammad Ali"
                    android:textColor="?attr/inputTextColor"
                    android:textColorHint="?attr/inputHintColor"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llmobile"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/round_edit_text_background"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    app:tint="?inputIconColor"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_phone" />

                <TextView
                    android:id="@+id/phonenumber"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/round_edit_text_background"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="0300-0000000"
                    android:textColor="?attr/inputTextColor"
                    android:textColorHint="?attr/inputHintColor"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lladdress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/round_edit_text_background"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    app:tint="?inputIconColor"
                    app:srcCompat="@drawable/ic_location" />

                <TextView
                    android:id="@+id/address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/round_edit_text_background"
                    android:gravity="center_vertical"
                    android:hint="@string/address"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="?attr/inputTextColor"
                    android:textColorHint="?attr/inputHintColor"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llcountry"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/round_edit_text_background"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    app:tint="?inputIconColor"
                    app:srcCompat="@drawable/ic_location" />

                <TextView
                    android:id="@+id/country"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/round_edit_text_background"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Select Country"
                    android:textColor="?attr/inputTextColor"
                    android:textColorHint="?attr/inputHintColor"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llstates"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/round_edit_text_background"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    app:tint="?inputIconColor"
                    app:srcCompat="@drawable/ic_location" />

                <TextView
                    android:id="@+id/states"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/round_edit_text_background"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Select State"
                    android:textColor="?attr/inputTextColor"
                    android:textColorHint="?attr/inputHintColor"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llcity"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/round_edit_text_background"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    app:tint="?inputIconColor"
                    app:srcCompat="@drawable/ic_location" />

                <TextView
                    android:id="@+id/city"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/round_edit_text_background"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Select City"
                    android:textColor="?attr/inputTextColor"
                    android:textColorHint="?attr/inputHintColor"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />


            </LinearLayout>


            <LinearLayout
                android:id="@+id/llblood_group"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/round_edit_text_background"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    app:tint="?inputIconColor"
                    app:srcCompat="@drawable/ic_blood_group" />

                <TextView
                    android:id="@+id/blood_group"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/round_edit_text_background"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Select Blood Group"
                    android:textColor="?attr/inputTextColor"
                    android:textColorHint="?attr/inputHintColor"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />


            </LinearLayout>


            <LinearLayout
                android:id="@+id/lldate_of_birth"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/round_edit_text_background"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    app:tint="?inputIconColor"
                    app:srcCompat="@drawable/ic_date" />

                <TextView
                    android:id="@+id/dob"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/round_edit_text_background"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Date Of Birth"
                    android:textColor="?attr/inputTextColor"
                    android:textColorHint="?attr/inputHintColor"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp" />

            </LinearLayout>




        </LinearLayout>
    </ScrollView>
</LinearLayout>