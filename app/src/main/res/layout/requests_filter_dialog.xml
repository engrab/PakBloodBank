                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/all_blood_group"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/btn_rect"
                                android:gravity="center"
                                android:text="@string/all"
                                android:textColor="@android:color/white" />

                            <Button
                                android:id="@+id/btn_a_positive"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rect"
                                android:gravity="center"
                                android:text="A+"
                                android:textColor="@android:color/white" />

                            <Button
                                android:id="@+id/btn_a_negative"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rect"
                                android:gravity="center"
                                android:text="A-"
                                android:textColor="@android:color/white" />

                            <Button
                                android:id="@+id/btn_b_positive"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rect"
                                android:gravity="center"
                                android:text="B+"
                                android:textColor="@android:color/white" />

                            <Button
                                android:id="@+id/btn_b_negative"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rect"
                                android:gravity="center"
                                android:text="B-"
                                android:textColor="@android:color/white" />

                            <Button
                                android:id="@+id/btn_ab_positive"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rect"
                                android:gravity="center"
                                android:text="AB+"
                                android:textColor="@android:color/white" />

                            <Button
                                android:id="@+id/btn_ab_negative"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rect"
                                android:gravity="center"
                                android:text="AB-"
                                android:textColor="@android:color/white" />


                            <Button
                                android:id="@+id/btn_o_positive"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rect"
                                android:gravity="center"
                                android:text="O+"
                                android:textColor="@android:color/white" />

                            <Button
                                android:id="@+id/btn_o_negative"
                                android:layout_width="@dimen/_60sdp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rect"
                                android:gravity="center"
                                android:text="O-"
                                android:textColor="@android:color/white" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>

